  url = {https://ru.wikipedia.org/w/index.php?title=%D0%92%D0%B5%D0%BD%D0%B5%D1%80%D0%B0_%D0%B2_%D0%BC%D0%B5%D1%85%D0%B0%D1%85&oldid=151845245},
  urldate = {2026-11-15},
  abstract = {«Вене́ра в меха́х» (нем. Venus im Pelz) — повесть австрийского писателя Леопольда фон Захера-Мазоха (1869), самое известное его произведение. Изображённая в ней тяга получать удовольствие, испытывая унижения и насилие, вскоре после её публикации стала предметом специальных исследований и получила название мазохизма. Повесть вошла в первый том сборника «Наследие Каина», изданный в 1870 году. В её названии и сюжете обыгрывается картина Тициана «Венера перед зеркалом», которая в то время находилась в Императорском Эрмитаже.},
